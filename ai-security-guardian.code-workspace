{
  "folders": [
    {
      "name": "🛡 Guardian — Frontend",
      "path": "frontend"
    },
    {
      "name": "⚡ Guardian — Backend",
      "path": "backend"
    },
    {
      "name": "📁 Root",
      "path": "."
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.associations": {
      "*.jsx": "javascriptreact"
    },
    "emmet.includeLanguages": {
      "javascript": "javascriptreact"
    },
    "css.customData": [],
    "editor.quickSuggestions": {
      "strings": true
    },
    "python.defaultInterpreterPath": "./backend/venv/bin/python",
    "python.formatting.provider": "black",
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "terminal.integrated.env.linux": {
      "PYTHONPATH": "${workspaceFolder}"
    }
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "ms-python.python",
      "ms-python.black-formatter",
      "bradlc.vscode-tailwindcss",
      "PKief.material-icon-theme",
      "formulahendry.auto-rename-tag",
      "christian-kohler.path-intellisense",
      "mongodb.mongodb-vscode"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🚀 Backend (uvicorn)",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["main:app", "--reload", "--port", "8000"],
        "cwd": "${workspaceFolder:⚡ Guardian — Backend}",
        "envFile": "${workspaceFolder:📁 Root}/.env"
      },
      {
        "name": "🌐 Frontend (vite)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder:🛡 Guardian — Frontend}"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Install Frontend",
        "type": "shell",
        "command": "npm install",
        "options": { "cwd": "${workspaceFolder:🛡 Guardian — Frontend}" },
        "group": "build"
      },
      {
        "label": "Install Backend",
        "type": "shell",
        "command": "pip install -r requirements.txt",
        "options": { "cwd": "${workspaceFolder:⚡ Guardian — Backend}" },
        "group": "build"
      },
      {
        "label": "Docker Up",
        "type": "shell",
        "command": "docker-compose up --build",
        "options": { "cwd": "${workspaceFolder:📁 Root}" },
        "group": "build"
      }
    ]
  }
}
